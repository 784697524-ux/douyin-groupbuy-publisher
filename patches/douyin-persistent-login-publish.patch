+def douyin_profile_dir(account_file: str | os.PathLike[str]) -> Path:
+    account_name = Path(account_file).name
+    if account_name.endswith(".json"):
+        account_name = account_name[:-5]
+    return Path(BASE_DIR) / "browser_profiles" / account_name
+
+
+def douyin_launch_args() -> list[str]:
+    return [
+        "--no-sandbox",
+        "--disable-blink-features=AutomationControlled",
+        "--lang=zh-CN",
+        "--disable-infobars",
+        "--start-maximized",
+    ]
+
+
+async def _locator_visible(locator) -> bool:
+    try:
+        if not await locator.count():
+            return False
+        return await locator.is_visible()
+    except Exception:
+        return False
+
+
+def _safe_page_url(page: Page | None) -> str:
+    if page is None:
+        return ""
+    try:
+        return page.url
+    except Exception:
+        return ""
+
+
+def _page_is_closed(page: Page | None) -> bool:
+    if page is None:
+        return True
+    try:
+        return page.is_closed()
+    except Exception:
+        return True
+
+
+async def active_douyin_page(context, preferred: Page | None = None) -> Page:
+    pages = []
+    if preferred is not None:
+        pages.append(preferred)
+    try:
+        pages.extend(context.pages)
+    except Exception:
+        pass
+
+    seen = set()
+    live_pages = []
+    for page in pages:
+        marker = id(page)
+        if marker in seen:
+            continue
+        seen.add(marker)
+        if not _page_is_closed(page):
+            live_pages.append(page)
+
+    for page in live_pages:
+        if "creator.douyin.com" in _safe_page_url(page):
+            return page
+    if live_pages:
+        return live_pages[-1]
+    return await context.new_page()
+
+
+async def has_visible_douyin_login(page: Page) -> bool:
+    if _page_is_closed(page):
+        return False
+    markers = [
+        page.get_by_text("扫码登录", exact=True).first,
+        page.get_by_text("手机号登录", exact=True).first,
+        page.get_by_text("验证码登录", exact=True).first,
+        page.get_by_text("我是创作者", exact=True).first,
+        page.locator('input[placeholder*="请输入手机号"]').first,
+        page.locator('input[placeholder*="请输入验证码"]').first,
+        page.get_by_role("img", name="二维码").first,
+    ]
+    for marker in markers:
+        if await _locator_visible(marker):
+            return True
+    return False
+
+
+async def hydrate_douyin_context_from_cookie_file(context, account_file: str | os.PathLike[str]) -> None:
+    cookie_file = Path(account_file)
+    if not cookie_file.is_file():
+        return
+    try:
+        state = json.loads(cookie_file.read_text(encoding="utf-8"))
+        cookies = state.get("cookies") or []
+        if cookies:
+            await context.add_cookies(cookies)
+    except Exception as exc:
+        douyin_logger.warning(_msg("😵", f"旧 cookie 导入 Profile 失败，继续使用浏览器登录态: {exc}"))
+
